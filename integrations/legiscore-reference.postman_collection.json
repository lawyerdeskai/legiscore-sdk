    {
      "name": "webhooks",
      "description": "Manage your own delivery endpoints: list, create, update, delete, rotate secret.",
      "item": [
        {
          "name": "List webhooks",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/webhooks",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "webhooks"
              ]
            },
            "description": "List the delivery endpoints registered against your key, with their events and whether each is active. Secrets are never returned here."
          }
        },
        {
          "name": "Create a webhook",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/webhooks",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "webhooks"
              ]
            },
            "description": "Register a delivery endpoint and the events it should receive. The signing secret is returned exactly once, in this response, and can never be read back: store it as you receive it. Deliveries are signed with it, and your handler should verify every one.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"\",\n  \"url\": \"\",\n  \"events\": [\n    \"\"\n  ],\n  \"custom_headers\": {}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Update a webhook",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/webhooks/{{webhook_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "webhooks",
                "{{webhook_id}}"
              ]
            },
            "description": "Change the name, URL, event list, custom headers or active flag of one of your webhooks. Fields you omit are left as they are. Changing the URL does not change the signing secret.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"\",\n  \"url\": \"\",\n  \"events\": [\n    \"\"\n  ],\n  \"custom_headers\": {},\n  \"is_active\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Delete a webhook",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/webhooks/{{webhook_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "webhooks",
                "{{webhook_id}}"
              ]
            },
            "description": "Remove one of your webhooks. Deliveries stop immediately and the signing secret is gone with it."
          }
        },
        {
          "name": "Rotate a webhook secret",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/webhooks/{{webhook_id}}/rotate-secret",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "webhooks",
                "{{webhook_id}}",
                "rotate-secret"
              ]
            },
            "description": "Issue a new signing secret for one of your webhooks. The new secret is returned exactly once and the old one stops verifying at once, so deploy the new secret to your handler in the same change."
          }
        }
      ]
    }
  ]
