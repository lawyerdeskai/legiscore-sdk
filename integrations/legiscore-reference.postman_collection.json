{
  "info": {
    "name": "LegiScore Partner API: reference",
    "description": "Generated by spec/build_postman.py from legiscore-openapi.json. Do not edit by hand.\n\nEvery operation the partner API exposes, grouped by module. For the order you actually integrate in, use the guided collection beside this one.\n\nProgrammatic access to LegiScore title search and legal opinion reports.\n\nAuthentication: send your `lsk_` key as `X-API-Key` (or `Authorization: Bearer lsk_...`).\nRate limits are per key. Exceeding one returns 429 with a `Retry-After` header.\n\nTypical flow: presign + upload documents, POST /api/requests to create the case, then either poll `/api/cases/{case_id}/status` or receive a webhook. A case can pause for missing documents, document review, or risk acknowledgements; each pause has a matching resume endpoint.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "key",
        "value": "X-API-Key",
        "type": "string"
      },
      {
        "key": "value",
        "value": "{{api_key}}",
        "type": "string"
      },
      {
        "key": "in",
        "value": "header",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://opinion.legiscore.in",
      "type": "string"
    },
    {
      "key": "case_id",
      "value": "",
      "type": "string",
      "description": "A case id from POST /api/requests."
    },
    {
      "key": "dimension",
      "value": "",
      "type": "string",
      "description": "A lookup dimension name from the catalog."
    },
    {
      "key": "job_id",
      "value": "",
      "type": "string",
      "description": "A raw-search or property-extraction job id."
    },
    {
      "key": "session_id",
      "value": "",
      "type": "string",
      "description": "A translation session id from POST /api/v1/translate/submit."
    },
    {
      "key": "slot_index",
      "value": "",
      "type": "string",
      "description": "The position of a slot in the missing-documents list, starting at 0."
    },
    {
      "key": "state",
      "value": "",
      "type": "string",
      "description": "A state slug, e.g. telangana."
    },
    {
      "key": "webhook_id",
      "value": "",
      "type": "string",
      "description": "The id of one of your registered webhooks."
    }
  ],
  "item": [
    {
      "name": "core",
      "description": "Uploads, credit balance and scenario reference data. Shared by every module.",
      "item": [
        {
          "name": "List scenarios",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/scenarios?category=&state_id=",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "scenarios"
              ],
              "query": [
                {
                  "key": "category",
                  "value": "",
                  "disabled": true,
                  "description": "string, optional"
                },
                {
                  "key": "state_id",
                  "value": "",
                  "disabled": true,
                  "description": "integer, optional"
                }
              ]
            },
            "description": "List the diligence scenarios your key may run, optionally filtered by category or state. A scenario is the template a case runs against: it decides which searches run, which fields are extracted and which template the report uses. Scenarios published for everyone and scenarios configured for your organisation both appear."
          }
        },
        {
          "name": "Get your credit balance",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/credits",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "credits"
              ]
            },
            "description": "Return the credit balances your key can draw on, and which one a new case would be charged to by default. The key itself determines the organisation; there is no account or tenant identifier to pass."
          }
        },
        {
          "name": "List custom field configurations",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/custom-field-configs",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "custom-field-configs"
              ]
            },
            "description": "List the custom field schemas your key may attach to a new case through custom_field_schema_ids. The set is resolved from your key: your own, your organisation's, and any published for general use."
          }
        },
        {
          "name": "Complete an upload",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/uploads/complete",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "uploads",
                "complete"
              ]
            },
            "description": "Confirm that the PUT finished and register the file, using the objectName that presignUpload returned. Returns the document_id you pass to createCase. Call it only after the PUT has returned 200; calling it early is rejected. An Idempotency-Key header is honoured, so a retried call after a lost response returns the first result instead of registering the file twice.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"objectName\": \"\",\n  \"fileName\": \"\",\n  \"fileSize\": 0,\n  \"contentType\": \"\",\n  \"success\": true,\n  \"content_hash\": \"\",\n  \"page_count\": 0\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Presign an upload",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/uploads/presign",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "uploads",
                "presign"
              ]
            },
            "description": "Ask for a short-lived signed URL to upload one file straight to object storage. Send the file name, its byte size and its content type; you get back the URL to PUT the bytes to and an objectName to pass to completeUpload once the PUT returns 200. The content type must be one we accept and the size must be within the per-file limit, both of which are checked here rather than on the PUT.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fileName\": \"\",\n  \"fileSize\": 0,\n  \"contentType\": \"\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "reports",
      "description": "Create a legal opinion case, follow it to completion, answer review pauses, fetch the report.",
      "item": [
        {
          "name": "Read the risk-acknowledgement pause",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/cases/{{case_id}}/acknowledgements",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "cases",
                "{{case_id}}",
                "acknowledgements"
              ]
            },
            "description": "Read the title risks a case has raised, together with any decisions already recorded. Valid only while the case is paused at the acknowledgement checkpoint."
          }
        },
        {
          "name": "Answer the missing-documents pause",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/cases/{{case_id}}/continue",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "cases",
                "{{case_id}}",
                "continue"
              ]
            },
            "description": "Resume a case paused for missing documents, either by supplying new document ids or by setting proceed_anyway so the report is produced and records the gap. Answering one pause can surface the next, so poll the status again afterwards rather than assuming the case is finished.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"new_document_ids\": [],\n  \"proceed_anyway\": false,\n  \"document_annotations\": [],\n  \"split_document_ids\": []\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Read the document-analysis pause",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/cases/{{case_id}}/document-review",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "cases",
                "{{case_id}}",
                "document-review"
              ]
            },
            "description": "Read the details extracted from your documents before the government-record searches run against them: document number, date, parties, survey number, house number. Valid only while the case is paused at the document-analysis checkpoint."
          }
        },
        {
          "name": "List case files",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/cases/{{case_id}}/files?kinds=",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "cases",
                "{{case_id}}",
                "files"
              ],
              "query": [
                {
                  "key": "kinds",
                  "value": "",
                  "disabled": true,
                  "description": "string, optional"
                }
              ]
            },
            "description": "Inventory every file a case produced: the documents you uploaded, anything added during a review pause, the search artefacts and the report itself. Each entry carries a short-lived signed download URL, so fetch what you need soon after listing rather than storing the URLs."
          }
        },
        {
          "name": "Download all case files as a ZIP",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/cases/{{case_id}}/files/zip?kinds=",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "cases",
                "{{case_id}}",
                "files",
                "zip"
              ],
              "query": [
                {
                  "key": "kinds",
                  "value": "",
                  "disabled": true,
                  "description": "string, optional"
                }
              ]
            },
            "description": "Stream every file on the case as a single ZIP, foldered by kind, optionally narrowed with the kinds filter. The response is binary, not JSON. Very large archives are refused rather than truncated."
          }
        },
        {
          "name": "Read the missing-documents pause",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/cases/{{case_id}}/missing-documents",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "cases",
                "{{case_id}}",
                "missing-documents"
              ]
            },
            "description": "Read the documents a case is waiting for. Valid only while the case is paused at the missing-documents checkpoint; asking at any other time returns 400 rather than an empty list, so dispatch on internal_status from getCaseStatus first."
          }
        },
        {
          "name": "Link documents to a missing-documents slot",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/cases/{{case_id}}/missing-documents/{{slot_index}}/link",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "cases",
                "{{case_id}}",
                "missing-documents",
                "{{slot_index}}",
                "link"
              ]
            },
            "description": "Attach documents you have uploaded to one specific slot in the missing-documents list, so the case shows which requested document each upload satisfies. Optional: continueCase accepts the same document ids without slot detail. This one endpoint needs an extra permission on your key; a 403 here means asking us to grant it, not a bad request.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"document_ids\": [\n    \"\"\n  ],\n  \"slot_id\": \"\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Get the final report",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/cases/{{case_id}}/result",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "cases",
                "{{case_id}}",
                "result"
              ]
            },
            "description": "Return the completed report and property score for a case. While the case is still running this returns 409 with the current state rather than a partial report, so poll getCaseStatus and call this once the state is completed."
          }
        },
        {
          "name": "Get case status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/cases/{{case_id}}/status",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "cases",
                "{{case_id}}",
                "status"
              ]
            },
            "description": "Poll a case. Returns a stable public state (queued, running, awaiting_review, completed, failed), a progress figure, a human-readable message and your own metadata echoed back. Built to be called often; every ten seconds is a sensible floor."
          }
        },
        {
          "name": "Answer the risk-acknowledgement pause",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/cases/{{case_id}}/submit-acknowledgements",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "cases",
                "{{case_id}}",
                "submit-acknowledgements"
              ]
            },
            "description": "Record a decision against each risk and release the case for final report generation. This writes a legal acceptance record attributed to whoever's key made the call, so it should carry a person's decision rather than a default set in code. Send each item back whole with a decision added; dropping fields off the generated item loses information the report needs.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"acknowledgements\": [\n    {}\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Answer the document-analysis pause",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/cases/{{case_id}}/submit-document-review",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "cases",
                "{{case_id}}",
                "submit-document-review"
              ]
            },
            "description": "Accept the extracted details as they are, or send corrections as a list of field updates, then let the searches run. A wrong survey number here makes every downstream search wrong, so this is the cheapest place to fix one.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"updates\": [],\n  \"proceed_to_searches\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Create a case",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/requests",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "requests"
              ]
            },
            "description": "Open a new case over documents you have already uploaded. Requires documentIds and a propertyFocus object describing the property; every other field has a default resolved from your key. Each document id is checked to be yours before anything is charged. Returns the case_id you use for every later call. Supply an Idempotency-Key header and a repeat of the same request returns the first response rather than opening and charging a second case; the same key with a different body is rejected.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"purpose\": \"\",\n  \"propertyFocus\": {},\n  \"processingType\": \"legal_opinion\",\n  \"documentIds\": [\n    \"\"\n  ],\n  \"enableMissingDocumentReview\": true,\n  \"enableAcknowledgementReview\": true,\n  \"enableDocumentAnalysisReview\": true,\n  \"enableAnomalyReview\": true,\n  \"scenario_code\": \"\",\n  \"scenario_instructions\": \"\",\n  \"case_name\": \"\",\n  \"special_upload_assignments\": {},\n  \"split_document_ids\": [\n    \"\"\n  ],\n  \"payment_order_id\": \"\",\n  \"credit_source\": \"personal\",\n  \"credit_source_org_id\": \"\",\n  \"credit_source_branch_id\": \"\",\n  \"vault_property_id\": \"\",\n  \"recipient_contacts\": [\n    {}\n  ],\n  \"custom_field_schema_ids\": [\n    \"\"\n  ],\n  \"custom_field_value_seed\": {},\n  \"missing_document_seeds\": [\n    {}\n  ],\n  \"metadata\": {},\n  \"template_id\": \"\",\n  \"project_id\": \"\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Download a case document",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/documents/{{case_id}}?format=",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "documents",
                "{{case_id}}"
              ],
              "query": [
                {
                  "key": "format",
                  "value": "pdf",
                  "disabled": true,
                  "description": "string, optional, default pdf"
                }
              ]
            },
            "description": "Download the report for a case in the requested format. Ownership is enforced against your key: another organisation's case is reported as not found rather than as forbidden."
          }
        }
      ]
    },
    {
      "name": "search",
      "description": "Raw search across the state land-record portals.",
      "item": [
        {
          "name": "Get the search catalog",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/raw-search/catalog",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "raw-search",
                "catalog"
              ]
            },
            "description": "Return the full catalog of searches: every state, the search types available in it, and the input schema each one accepts. This is the reference you build a search form or a parameter mapping from."
          }
        },
        {
          "name": "List raw searches",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/raw-search/history?limit=&offset=&state=&search_type=&status=&include_extras=",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "raw-search",
                "history"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "20",
                  "disabled": true,
                  "description": "integer, optional, default 20"
                },
                {
                  "key": "offset",
                  "value": "0",
                  "disabled": true,
                  "description": "integer, optional, default 0"
                },
                {
                  "key": "state",
                  "value": "",
                  "disabled": true,
                  "description": "string, optional"
                },
                {
                  "key": "search_type",
                  "value": "",
                  "disabled": true,
                  "description": "string, optional"
                },
                {
                  "key": "status",
                  "value": "",
                  "disabled": true,
                  "description": "string, optional"
                },
                {
                  "key": "include_extras",
                  "value": "False",
                  "disabled": true,
                  "description": "boolean, optional, default False"
                }
              ]
            },
            "description": "List your recent raw searches, newest first, with optional filters on state, search type and status. Set include_extras to also get the parameters each search ran with and a summary of its result."
          }
        },
        {
          "name": "List lookup dimensions",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/raw-search/lookups",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "raw-search",
                "lookups"
              ]
            },
            "description": "List the (state, dimension) pairs that have a lookup table behind them, for example districts or sub-registrar offices. Use it to discover what getLookupValues can be asked for."
          }
        },
        {
          "name": "Get lookup values",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/raw-search/lookups/{{state}}/{{dimension}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "raw-search",
                "lookups",
                "{{state}}",
                "{{dimension}}"
              ]
            },
            "description": "Return the valid values for one lookup dimension in one state, so a search parameter can be picked from a list instead of typed."
          }
        },
        {
          "name": "List searchable states",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/raw-search/states",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "raw-search",
                "states"
              ]
            },
            "description": "List the states raw search currently covers, as the slugs the other search calls expect."
          }
        },
        {
          "name": "Get raw search status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/raw-search/status/{{job_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "raw-search",
                "status",
                "{{job_id}}"
              ]
            },
            "description": "Poll a raw search job. Returns its state and, once finished, the extracted result plus freshly signed URLs for any documents the portal returned."
          }
        },
        {
          "name": "Submit a raw search",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/raw-search/submit",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "raw-search",
                "submit"
              ]
            },
            "description": "Queue one search against one state portal and return a job id immediately. Takes the state slug, the search type slug and the parameters that search needs; use getSearchCatalog to discover which parameters a given state and search type accept. Poll getRawSearchStatus for the outcome.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"state\": \"\",\n  \"search_type\": \"\",\n  \"params\": {},\n  \"param_labels\": {},\n  \"payment_order_id\": \"\",\n  \"credit_source\": \"personal\",\n  \"credit_source_org_id\": \"\",\n  \"credit_source_branch_id\": \"\",\n  \"force\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "translate",
      "description": "Translate a document into another Indian language.",
      "item": [
        {
          "name": "Translate a DOCX",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/docx-translate",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "docx-translate"
              ]
            },
            "description": "Translate a DOCX file and return the translated DOCX directly in the response. Synchronous, for documents small enough to wait on; use submitTranslation for anything larger.",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
